# g02-g17 full rack (AMD Helios): 6 switch trays st1-st6 (SONiC, 2 ASICs each) + 18 compute trays ct01-ct18 (4 GPUs).
# Git-ignored (rack addresses). No passwords: logins use the jump host's id_cluster key.
# Run ON the jump host (rck-g03-...-jump) - the rack's 10.255.4.x network is only reachable from there:
#   python tools/link_check.py scan --inventory inventory/g02-g17.local.yaml
# From a laptop instead, uncomment transport.jump (key / agent login to tenant-hpe@165.204.38.103:8059); the jump
# host's sshd allows only a few sessions, so large scans are faster on the jump host itself.
rack: g02-g17

transport:
  kind: ssh
  connect_timeout: 20
  jump: {host: 165.204.38.103, port: 8059, user: tenant-hpe, via: exec}   # from a laptop; comment out when run ON the jump host

defaults:
  switch:
    user: tenant_hpe
    key_file: ~/.ssh/id_cluster
  compute:
    user: tenant-hpe             # sudo without a prompt for afmctl
    key_file: ~/.ssh/id_cluster

switches:
  - {name: st1, host: 10.255.4.71}
  - {name: st2, host: 10.255.4.72}
  - {name: st3, host: 10.255.4.73}
  - {name: st4, host: 10.255.4.74}
  - {name: st5, host: 10.255.4.75}
  - {name: st6, host: 10.255.4.76}

# slot = AFM slot-id (CT n = slot n-1). ct05 is quarantined (tray Down): its 144 links are reported as one cause.
computes:
  - {name: ct01, host: 10.255.4.47, slot: 0}
  - {name: ct02, host: 10.255.4.48, slot: 1}
  - {name: ct03, host: 10.255.4.49, slot: 2}
  - {name: ct04, host: 10.255.4.50, slot: 3}
  - {name: ct05, host: 10.255.4.51, slot: 4, quarantine: {reason: Down, since: '2026-10-16', until: '2026-10-19'}}
  - {name: ct06, host: 10.255.4.52, slot: 5}
  - {name: ct07, host: 10.255.4.53, slot: 6}
  - {name: ct08, host: 10.255.4.54, slot: 7}
  - {name: ct09, host: 10.255.4.55, slot: 8}
  - {name: ct10, host: 10.255.4.56, slot: 9}
  - {name: ct11, host: 10.255.4.57, slot: 10}
  - {name: ct12, host: 10.255.4.58, slot: 11}
  - {name: ct13, host: 10.255.4.59, slot: 12}
  - {name: ct14, host: 10.255.4.60, slot: 13}
  - {name: ct15, host: 10.255.4.61, slot: 14}
  - {name: ct16, host: 10.255.4.62, slot: 15}
  - {name: ct17, host: 10.255.4.63, slot: 16}
  - {name: ct18, host: 10.255.4.64, slot: 17}

afm:                              # AFM API from the jump host (controllers on st1-st3); password typed per run, never stored
  url: https://10.255.4.71
  verify_tls: false
  auth: {username: admin, password_env: HELIOS_AFM_PASSWORD, tenant: default}
